# Configurações da Aplicação
PORT=3000
NODE_ENV=development

# Configuração do Banco de Dados (MySQL)
# Para execução local na máquina host:
DATABASE_URL="mysql://quimiport_user:REPLACE_WITH_UNIQUE_URL_ENCODED_PASSWORD@localhost:3306/quimiport"

# Variáveis do MySQL para o Docker Compose
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=quimiport
MYSQL_USER=quimiport_user
MYSQL_PASSWORD=
