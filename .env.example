# Configuracoes da Aplicacao
PORT=3000
NODE_ENV=development

# Variaveis do MySQL para o Docker Compose
# Obrigatorio definir senhas seguras antes de iniciar os containers
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=quimiport
MYSQL_USER=quimiport_user
MYSQL_PASSWORD=

# Configuracao do Banco de Dados (MySQL) via Prisma
# Para execucao via Docker Compose (comunicando com o servico db):
# DATABASE_URL="mysql://quimiport_user:REPLACE_WITH_UNIQUE_URL_ENCODED_PASSWORD@db:3306/quimiport"
# Para execucao local direta no host:
DATABASE_URL="mysql://quimiport_user:REPLACE_WITH_UNIQUE_URL_ENCODED_PASSWORD@localhost:3306/quimiport"
